/src/generated/prisma

# presale P2-C2 초기 백필 — 일회성 batch 원본 JSON 결과(재현 가능, 커밋 불필요)
scripts/_backfill_results/

# MASTER M4-B 부산 전체 구축 — 구·군별 batch 원본 JSON 결과(재현 가능, 커밋 불필요)
scripts/_m4b_results/

# DATA_COVERAGE_FIX_V1 — 부산 backfill resumable checkpoint/진행 로그(재현 가능, 커밋 불필요)
scripts/_data_coverage_fix_v1_results/

# STEP R4/R4.1 재개발 ingestion — quality report/sigungu 해석 원본 JSON 결과(재현 가능, 커밋 불필요)
scripts/redevelopment/_results/

# TRADE_HISTORY_DATA_V1 — backfill/sync 실행 로그(재현 가능, 커밋 불필요. manifest는 별도로 커밋함)
scripts/_backfill_trade_history_results/
scripts/_sync_trade_history_results/

# BRAND STEP 57-A — 브랜드 원본(PSD급 고해상도 PNG) 로컬 보관 전용.
# production에서 실제로 서빙하는 최적화 자산은 public/brand/에 별도로 커밋된다.
brand-source/

# git worktree isolation (local dev only)
.worktrees/
