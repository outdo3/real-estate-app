generator client {
  provider = "prisma-client-js"
}

// Supabase(PostgreSQL)를 데이터베이스로 사용한다. DATABASE_URL은 .env에서 설정.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  USER
  VERIFIED
  ADMIN
}

// NextAuth의 AdapterUser 타입 계약(name/image 필드)을 그대로 만족시키면서도,
// 실제 DB 컬럼명은 요청된 대로 nickname/avatar_url이 되도록 @map으로 매핑한다.
// (Prisma Client 상의 속성명은 name/image, DB 컬럼명은 nickname/avatar_url)
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  name          String    @map("nickname")
  image         String?   @map("avatar_url")
  role          Role      @default(USER)
  // 관리자가 커뮤니티 이용을 제한(강퇴)한 계정. 로그인 자체는 막지 않되,
  // 글/댓글 작성 등 커뮤니티 활동을 차단하는 데 사용한다.
  banned        Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts Account[]
  sessions Session[]
  posts    Post[]
  comments Comment[]

  @@map("users")
}

// NextAuth(Auth.js) PrismaAdapter가 요구하는 표준 스키마
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  // 관리자 권한으로 게시글을 목록 상단에 고정
  pinned    Boolean  @default(false)
  // 단지 상세페이지에서 연동되는 커뮤니티 글 태그 — 자유 텍스트, 정확 일치로만 필터링
  aptName   String?  @map("apt_name")
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author   User      @relation(fields: [authorId], references: [id])
  comments Comment[]

  @@index([pinned, createdAt])
  @@index([aptName, createdAt])
  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([postId])
  @@map("comments")
}

// ── 기존 실거래가 시드/오프라인 스크립트용 모델 (라이브 앱에서는 사용하지 않음) ──
model Transaction {
  id          Int      @id @default(autoincrement())
  rank        Int
  name        String
  price       String
  priceChange String
  changeType  String // "up" or "new"
  typeLabel   String // "반등" or "신고가"
  info        String // "73.27m² 25평 • 26.07.18"
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now())
}

model TradeHistory {
  id        Int      @id @default(autoincrement())
  aptName   String
  tradeDate String
  price     Int // 억 단위 저장 (예: 53)
  priceStr  String // 노출용 (예: 53억 2,000만)
  area      String
  floor     Int
  tradeType String // 중개거래, 직거래
  createdAt DateTime @default(now())

  @@index([aptName])
}

// scripts/crawl_facilities.py가 오프라인으로 채우는 단지 커뮤니티 시설 정보.
// 실거래가처럼 실시간 API가 있는 데이터가 아니라, 스크립트가 주기적으로 수집해
// 미리 채워둔 값을 상세페이지가 그대로 읽어 보여준다.
model Apartment {
  id                  Int      @id @default(autoincrement())
  name                String
  dong                String?
  lawdCd              String?  @map("lawd_cd")
  // 이모지 태그 배열, 예: ["⛳ 골프연습장", "🏊 수영장"]. 정보가 없으면 null(빈 배열이 아님 —
  // "조사했지만 시설이 하나도 없다"와 "아직 조사 전"을 구분하기 위함).
  communityFacilities Json?    @map("community_facilities")
  // 건축물대장 표제부 공공데이터 기반. null은 "아직 조회 전/실패", 0은 취급하지 않는다
  // (총주차대수 0대·용적률 0%는 실제로 있을 수 없는 값이라 항상 "미확보"로 간주 — 조회
  // 로직도 0 이하 값은 저장하지 않는다).
  parkingCount        Int?     @map("parking_count")
  far                 Float?   @map("far") // 용적률(%)
  bcr                 Float?   @map("bcr") // 건폐율(%)
  // 총괄표제부 응답에 세대수도 같이 들어있어 캐싱해둔다. 네이버 스크래핑(비결정적 —
  // 매 요청 성공을 보장 못 함)에만 의존하면, parkingCount/far/bcr가 캐시 히트라 라이브
  // 조회를 건너뛴 요청에서는 세대수만 빠지는 문제가 실측으로 확인됐다.
  totalHouseholds     Int?     @map("total_households")
  // 건축물대장 총괄표제부 조회에 필요한 지번(예: "1544"). 이 값 없이는 동 전체를
  // 뒤져야 하는데, 실측 결과 그 방식은 신뢰할 수 없는 결과(엉뚱한 건물)만 반환해서
  // jibun을 사실상 필수로 요구하게 됐다 — apt-client.tsx가 실거래 데이터에서 얻은
  // jibun으로 /api/apt/[name]/info를 호출할 때마다 여기 저장해, 다음부터는 배치
  // 스크립트도 이 값을 재사용할 수 있게 한다.
  jibun               String?  @map("jibun")
  // @default(now())를 같이 둬서, Prisma를 거치지 않고 scripts/crawl_facilities.py가
  // Supabase REST API로 직접 INSERT할 때도(이 컬럼 값을 안 보내도) DB가 자동으로 채운다.
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([name, dong])
  @@map("apartments")
}

// AI 검색(/api/ai-search)의 의도 분류 + 최종 응답을 캐싱해 동일한 질문에 Gemini를
// 다시 호출하지 않게 한다(토큰 비용 절감 + 응답 속도). 정규화된 질문 문자열의 해시를
// 키로 쓴다 — 완전히 같은 문장일 때만 히트하는 단순한 캐시라, 유사하지만 다른 표현의
// 질문은 캐시되지 않고 새로 호출된다(요청된 범위 그대로).
model AiSearchCache {
  id        Int      @id @default(autoincrement())
  queryHash String   @unique @map("query_hash")
  query     String   @db.Text
  intent    String
  // Gemini 브리핑 텍스트 + 조회된 실제 데이터(리스트/통계/비교표)를 함께 저장 — 캐시
  // 히트 시 이 하나만 읽으면 프론트가 바로 렌더링할 수 있다.
  result    Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_search_cache")
}
