generator client {
  provider = "prisma-client-js"
}

// Supabase(PostgreSQL)를 데이터베이스로 사용한다. DATABASE_URL은 .env에서 설정.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  USER
  VERIFIED
  ADMIN
}

// NextAuth의 AdapterUser 타입 계약(name/image 필드)을 그대로 만족시키면서도,
// 실제 DB 컬럼명은 요청된 대로 nickname/avatar_url이 되도록 @map으로 매핑한다.
// (Prisma Client 상의 속성명은 name/image, DB 컬럼명은 nickname/avatar_url)
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  name          String    @map("nickname")
  image         String?   @map("avatar_url")
  role          Role      @default(USER)
  // 관리자가 커뮤니티 이용을 제한(강퇴)한 계정. 로그인 자체는 막지 않되,
  // 글/댓글 작성 등 커뮤니티 활동을 차단하는 데 사용한다.
  banned        Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts Account[]
  sessions Session[]
  posts    Post[]
  comments Comment[]

  @@map("users")
}

// NextAuth(Auth.js) PrismaAdapter가 요구하는 표준 스키마
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  // 관리자 권한으로 게시글을 목록 상단에 고정
  pinned    Boolean  @default(false)
  // 단지 상세페이지에서 연동되는 커뮤니티 글 태그 — 자유 텍스트, 정확 일치로만 필터링
  aptName   String?  @map("apt_name")
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author   User      @relation(fields: [authorId], references: [id])
  comments Comment[]

  @@index([pinned, createdAt])
  @@index([aptName, createdAt])
  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([postId])
  @@map("comments")
}

// ── 기존 실거래가 시드/오프라인 스크립트용 모델 (라이브 앱에서는 사용하지 않음) ──
model Transaction {
  id          Int      @id @default(autoincrement())
  rank        Int
  name        String
  price       String
  priceChange String
  changeType  String // "up" or "new"
  typeLabel   String // "반등" or "신고가"
  info        String // "73.27m² 25평 • 26.07.18"
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now())
}

model TradeHistory {
  id        Int      @id @default(autoincrement())
  aptName   String
  tradeDate String
  price     Int // 억 단위 저장 (예: 53)
  priceStr  String // 노출용 (예: 53억 2,000만)
  area      String
  floor     Int
  tradeType String // 중개거래, 직거래
  createdAt DateTime @default(now())

  @@index([aptName])
}

// scripts/crawl_facilities.py가 오프라인으로 채우는 단지 커뮤니티 시설 정보.
// 실거래가처럼 실시간 API가 있는 데이터가 아니라, 스크립트가 주기적으로 수집해
// 미리 채워둔 값을 상세페이지가 그대로 읽어 보여준다.
model Apartment {
  id                  Int      @id @default(autoincrement())
  name                String
  dong                String?
  lawdCd              String?  @map("lawd_cd")
  // 이모지 태그 배열, 예: ["⛳ 골프연습장", "🏊 수영장"]. 정보가 없으면 null(빈 배열이 아님 —
  // "조사했지만 시설이 하나도 없다"와 "아직 조사 전"을 구분하기 위함).
  communityFacilities Json?    @map("community_facilities")
  // 건축물대장 표제부 공공데이터 기반. null은 "아직 조회 전/실패", 0은 취급하지 않는다
  // (총주차대수 0대·용적률 0%는 실제로 있을 수 없는 값이라 항상 "미확보"로 간주 — 조회
  // 로직도 0 이하 값은 저장하지 않는다).
  parkingCount        Int?     @map("parking_count")
  far                 Float?   @map("far") // 용적률(%)
  bcr                 Float?   @map("bcr") // 건폐율(%)
  // 총괄표제부 응답에 세대수도 같이 들어있어 캐싱해둔다. 네이버 스크래핑(비결정적 —
  // 매 요청 성공을 보장 못 함)에만 의존하면, parkingCount/far/bcr가 캐시 히트라 라이브
  // 조회를 건너뛴 요청에서는 세대수만 빠지는 문제가 실측으로 확인됐다.
  totalHouseholds     Int?     @map("total_households")
  // 총괄표제부 useAprDay(사용승인일)를 "YYYY년"으로 캐싱. 세대수와 같은 이유(네이버
  // 스크래핑은 검색어에 지역 정보가 없어 동명의 타 지역 단지 값을 가져올 수 있음 —
  // 실측: "금호어울림"으로 검색 시 부산 서구(256세대)가 아닌 타 단지의 "1,549세대"가
  // 잡힘)로, 지번까지 정확히 지정해 조회하는 건축물대장 값을 우선한다.
  approvalDate        String?  @map("approval_date")
  // 건축물대장 총괄표제부 조회에 필요한 지번(예: "1544"). 이 값 없이는 동 전체를
  // 뒤져야 하는데, 실측 결과 그 방식은 신뢰할 수 없는 결과(엉뚱한 건물)만 반환해서
  // jibun을 사실상 필수로 요구하게 됐다 — apt-client.tsx가 실거래 데이터에서 얻은
  // jibun으로 /api/apt/[name]/info를 호출할 때마다 여기 저장해, 다음부터는 배치
  // 스크립트도 이 값을 재사용할 수 있게 한다.
  jibun               String?  @map("jibun")
  // @default(now())를 같이 둬서, Prisma를 거치지 않고 scripts/crawl_facilities.py가
  // Supabase REST API로 직접 INSERT할 때도(이 컬럼 값을 안 보내도) DB가 자동으로 채운다.
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([name, dong])
  @@map("apartments")
}

// MASTER M1/M2(docs/development/11-apartment-master-analysis.md,
// 12-apartment-master-design.md)에서 설계한 Apartment Master — MASTER M3(소량 실제
// 구축 검증) 대상 신규 모델. 기존 Apartment(위, 건축물대장 캐시 20건)를 대체하지 않고
// 병행한다 — 이번 STEP에서는 기존 코드가 이 모델을 사용하도록 전환하지 않는다.
//
// 한 행 = MOLIT aptSeq 1개(M2 §C 결론). 이름/동 문자열 매칭이 아니라 aptSeq(있으면)를
// 우선 식별자로 쓰고, normalizedName은 검색 보조용일 뿐 identity로 쓰지 않는다(M2 §I).
model ApartmentMaster {
  id Int @id @default(autoincrement())

  // 외부 식별자 — 내부 PK(id)와 분리, 둘 다 nullable(무거래/미확보 단지 수용, M2 §R)
  aptSeq       String? @unique @map("apt_seq") // MOLIT, "{lawdCd}-{일련번호}"
  // 건축물대장 총괄표제부 관리번호. 정수로 다루면 정밀도 손실 위험이 있어 문자열로만
  // 저장한다(M1 §K). 한 단지에 총괄표제부가 여러 건 잡히는 드문 사례가 있음이 기존
  // apt-building-info.ts 주석에서 이미 확인돼, DB unique 제약은 걸지 않는다(M3 §5).
  mgmBldrgstPk String? @map("mgm_bldrgst_pk")

  name           String // MOLIT aptNm 또는 건축물대장 bldNm 원본 표기
  normalizedName String @map("normalized_name") // 공백/"아파트" 접미사 제거 — 매칭 보조용

  // 지역/주소 — 원본 필드를 분리 보존한다(단일 텍스트 컬럼으로 뭉치지 않음, M2 §H)
  sido         String?
  sigungu      String?
  sggCd        String? @map("sgg_cd") // = lawdCd, MOLIT 원본
  umdName      String? @map("umd_name")
  umdCd        String? @map("umd_cd")
  jibun        String?
  roadAddress  String? @map("road_address") // 건축물대장 newPlatPlc(도로명주소 완성형)
  jibunAddress String? @map("jibun_address") // 건축물대장 platPlc(지번주소 완성형)

  // 좌표 — Kakao geocoding만 원천(M2 §I). area_only(행정구역 대표좌표)는 저장하지 않는다.
  latitude       Float?
  longitude      Float?
  geocodeQuality String? @map("geocode_quality") // 'exact' | 'normalized' | 'failed'

  // 건물 정보 — 단지 총괄 값으로 확정 가능한 것만 저장(동 단위 값을 단지 전체처럼 저장 금지)
  buildYear         Int?    @map("build_year") // MOLIT 건축년도(참고용)
  useApprovalDate   String? @map("use_approval_date") // 건축물대장 useAprDay 원본("YYYYMMDD")
  mainBuildingCount Int?    @map("main_building_count") // 건축물대장 mainBldCnt(동수)
  totalHouseholds   Int?    @map("total_households") // 건축물대장 hhldCnt(총괄표제부 확정값만)
  parkingCount      Int?    @map("parking_count") // 건축물대장 totPkngCnt(총괄표제부 확정값만)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([sggCd])
  @@index([normalizedName])
  @@index([umdCd, jibun])
  @@map("apartment_masters")
}

// AI 검색(/api/ai-search)의 의도 분류 + 최종 응답을 캐싱해 동일한 질문에 Gemini를
// 다시 호출하지 않게 한다(토큰 비용 절감 + 응답 속도). 정규화된 질문 문자열의 해시를
// 키로 쓴다 — 완전히 같은 문장일 때만 히트하는 단순한 캐시라, 유사하지만 다른 표현의
// 질문은 캐시되지 않고 새로 호출된다(요청된 범위 그대로).
model AiSearchCache {
  id        Int      @id @default(autoincrement())
  queryHash String   @unique @map("query_hash")
  query     String   @db.Text
  intent    String
  // Gemini 브리핑 텍스트 + 조회된 실제 데이터(리스트/통계/비교표)를 함께 저장 — 캐시
  // 히트 시 이 하나만 읽으면 프론트가 바로 렌더링할 수 있다.
  result    Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_search_cache")
}

// ══════════════════════════════════════════════════════════════════════════
// 오피스텔/생활형숙박시설(생숙)/재개발 — 데이터 수집 기반(스키마 + 파이프라인 스텁)
// ══════════════════════════════════════════════════════════════════════════

enum PropertyCategory {
  APT
  OFFICETEL
  LIVING_STAY
  REDEVELOPMENT
}

// 기존 Apartment 모델은 "MOLIT 아파트 실거래 매칭용 건축물대장 캐시"라는 좁은 용도로
// 이미 unique([name, dong])와 아파트 전용 조회 로직에 강하게 묶여 있어(apt-building-info.ts,
// api/apt/[name] 등 여러 곳이 이 제약을 전제로 함), 성격이 다른 오피스텔/생숙/재개발을
// 억지로 얹으면 기존 아파트 매칭 로직이 깨질 위험이 크다. category로 구분되는 범용
// 매물 테이블을 새로 둔다 — 실제 데이터 수집(services/publicDataService.ts)이 채워지기
// 전까지는 빈 테이블이며, /api/properties가 그대로 빈 배열을 정직하게 반환한다.
model Property {
  id              Int              @id @default(autoincrement())
  category        PropertyCategory
  name            String
  dong            String?
  lawdCd          String?          @map("lawd_cd")
  totalHouseholds Int?             @map("total_households")
  totalParking    Int?             @map("total_parking")
  buildYear       Int?             @map("build_year")
  approvalDate    String?          @map("approval_date")
  lat             Float?
  lng             Float?
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")

  @@unique([category, name, dong])
  @@index([category])
  @@map("properties")
}

// ═══════════════════════════════════════════════════════════
// STEP R4 — docs/development/R3B-redevelopment-master-schema-design.md
// 확정안 적용. 기존 RedevelopmentProject/RedevelopmentStage(단일 테이블,
// production 0건 확인)를 대체 — 원본 SourceRecord와 canonical Project를
// 분리한 2-엔티티 구조로 국토부/부산 등 복수 source를 안전하게 병합한다.
// ═══════════════════════════════════════════════════════════

enum RedevelopmentBusinessType {
  REDEVELOPMENT
  RECONSTRUCTION
  RESIDENTIAL_ENVIRONMENT
  SMALL_RECONSTRUCTION
  BLOCK_HOUSING
  OTHER
  UNKNOWN
}

enum RedevelopmentStage {
  PLANNED
  ZONE_DESIGNATED
  PROMOTION_COMMITTEE
  ASSOCIATION_APPROVED
  ARCHITECTURAL_REVIEW
  PUBLIC_OPERATOR_DESIGNATED
  PROJECT_IMPLEMENTATION_APPROVED
  MANAGEMENT_DISPOSITION_APPROVED
  RELOCATION_DEMOLITION
  CONSTRUCTION
  COMPLETED
  TRANSFER_REGISTERED
  DISSOLVED
  CANCELLED
  UNKNOWN
}

enum RedevelopmentProjectStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  UNKNOWN
}

enum RedevelopmentLocationType {
  PROJECT_SITE
  OFFICE
  APPROXIMATE
  UNKNOWN
}

enum RedevelopmentLocationConfidence {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum RedevelopmentGeocodeStatus {
  NOT_ATTEMPTED
  SUCCESS
  AMBIGUOUS
  FAILED
}

enum RedevelopmentMatchConfidence {
  EXACT
  HIGH
  MEDIUM
  LOW
  UNMATCHED
}

enum RedevelopmentMergeStatus {
  AUTO_MATCHED
  REVIEW_REQUIRED
  MANUAL_MATCHED
  UNMATCHED
}

model RedevelopmentProject {
  id Int @id @default(autoincrement())

  canonicalName  String @map("canonical_name")
  normalizedName String @map("normalized_name")

  sido    String
  sigungu String

  businessType  RedevelopmentBusinessType  @default(UNKNOWN) @map("business_type")
  stage         RedevelopmentStage         @default(UNKNOWN)
  projectStatus RedevelopmentProjectStatus @default(UNKNOWN) @map("project_status")

  householdCount Int? @map("household_count")

  lat                Float?
  lng                Float?
  locationType       RedevelopmentLocationType?       @map("location_type")
  locationConfidence RedevelopmentLocationConfidence? @map("location_confidence")
  geocodeStatus      RedevelopmentGeocodeStatus?      @map("geocode_status")
  geocodeSource      String?                          @map("geocode_source")

  // V2 polygon placeholder — geometry 컬럼은 아직 만들지 않음(R3B 참고).
  polygonSource String? @map("polygon_source")
  polygonRef    String? @map("polygon_ref")

  primarySource   String    @map("primary_source")
  sourceUpdatedAt DateTime? @map("source_updated_at")
  collectedAt     DateTime  @map("collected_at")

  needsReview Boolean @default(false) @map("needs_review")

  sourceRecords RedevelopmentSourceRecord[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sido, sigungu])
  @@index([businessType])
  @@index([stage])
  @@index([normalizedName])
  @@map("redevelopment_projects")
}

model RedevelopmentSourceRecord {
  id        Int                  @id @default(autoincrement())
  projectId Int                  @map("project_id")
  project   RedevelopmentProject @relation(fields: [projectId], references: [id])

  source         String
  sourceRecordId String @map("source_record_id")

  rawName             String  @map("raw_name")
  rawBusinessType     String? @map("raw_business_type")
  rawBusinessTypeCode String? @map("raw_business_type_code")
  rawStage            String? @map("raw_stage")
  rawStageCode        String? @map("raw_stage_code")
  rawHouseholdCount   String? @map("raw_household_count")
  rawLocation         String? @map("raw_location")

  rawPayload Json? @map("raw_payload")

  matchConfidence RedevelopmentMatchConfidence? @map("match_confidence")
  mergeStatus     RedevelopmentMergeStatus      @default(UNMATCHED) @map("merge_status")

  sourceUpdatedAt DateTime? @map("source_updated_at")
  collectedAt     DateTime  @map("collected_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([source, sourceRecordId])
  @@index([projectId])
  @@map("redevelopment_source_records")
}

// ══════════════════════════════════════════════════════════════════════════
// 분양/청약 — 청약홈 연동 기반(스키마 + 파이프라인 스텁)
// ══════════════════════════════════════════════════════════════════════════

enum PresaleHouseType {
  APT
  OFFICETEL
  URBAN // 도시형생활주택
  REMAIN // 잔여세대(무순위)
}

model Presale {
  id                    Int              @id @default(autoincrement())
  houseManageNo         String?          @unique @map("house_manage_no") // 주택관리번호(청약홈 PK)
  pblancNo              String?          @map("pblanc_no") // 공고번호 — houseManageNo와 항상 같다고 가정하지 않고 원본 그대로 별도 보존(P2-A 확인)
  houseName             String           @map("house_name")
  // 기존 4종 enum. 이번 P2-B에서는 삭제/대규모 변경하지 않는다(호환성 유지용 최소 매핑만 수행).
  // 공식 API 원본 분류값은 houseSecd/houseSecdName에 별도로 보존한다 — P2-A 확인 결과 이
  // enum이 기대하는 "오피스텔"/"도시형생활주택" 값은 getAPTLttotPblancDetail(APT 전용
  // endpoint)만으로는 원천적으로 나오지 않는다(별도 API 계열 필요, 향후 통합 정책 결정 대상).
  houseType             PresaleHouseType @map("house_type")
  // 공식 API 원본 주택유형 코드/명칭(예: "01"/"APT", "10"/"신혼희망타운") — houseType enum과
  // 별개로, 원본 값을 훼손 없이 그대로 보존한다.
  houseSecd             String?          @map("house_secd")
  houseSecdName         String?          @map("house_secd_name")
  // 분양/임대 구분 원본값(예: "0"/"분양주택", "1"/"분양전환 가능임대") — 임의로 분양/임대
  // 2분류로 축소하지 않고 원본 그대로 보존한다(P2-A 확인).
  rentSecd              String?          @map("rent_secd")
  rentSecdName          String?          @map("rent_secd_name")
  locationAddress       String?          @map("location_address")
  // 공급지역(시/도 단위) 코드/명칭 — SUBSCRPT_AREA_CODE/SUBSCRPT_AREA_CODE_NM. 시군구까지는
  // 세분화되어 있지 않다(P2-A 확인) — 시군구 단위 필터는 locationAddress 파싱이 별도로 필요.
  subscriptionAreaCode  String?          @map("subscription_area_code")
  subscriptionAreaName  String?          @map("subscription_area_name")
  latitude              Float?
  longitude             Float?
  totalSupplyHouseholds Int?             @map("total_supply_households")
  constructCompany      String?          @map("construct_company")
  // 사업주체(시행사) — 시공사(constructCompany)와 별개 개념, API 원본 BSNS_MBY_NM.
  businessEntityName    String?          @map("business_entity_name")

  announcementDate  DateTime? @map("announcement_date")
  // RCEPT_BGNDE/RCEPT_ENDDE에 매핑한다 — P2-A에서 이 두 필드가 특별공급/1·2순위·지역별
  // 세분화 접수기간 9종의 min/max와 50건 전수 정확히 일치함을 확인했으므로, 별도로
  // min/max를 계산하지 않고 API가 제공하는 이 값을 그대로 사용한다.
  receiptStartDate  DateTime? @map("receipt_start_date")
  receiptEndDate    DateTime? @map("receipt_end_date")
  winnerDate        DateTime? @map("winner_date")
  // 계약기간(CNTRCT_CNCLS_BGNDE/ENDDE) — P2-A 확인 결과 완결성이 높아(표본 50/50 non-null)
  // 저장 가치가 있다고 판단됨.
  contractStartDate DateTime? @map("contract_start_date")
  contractEndDate   DateTime? @map("contract_end_date")
  // 입주예정월(MVN_PREARNGE_YM) — "YYYYMM" 6자리 원본 문자열 그대로 보존한다. 일자 정보가
  // 없는 값을 DateTime으로 강제 변환(임의로 1일을 채우는 등)하지 않는다(P2-A 정책 확정).
  moveInExpectedYm  String?   @map("move_in_expected_ym")

  // 만원 단위(P2-A에서 실제 공고 3건을 언론 보도와 교차검증해 확정). PresaleHouseTypeDetail의
  // topAmount 값들 중 유효한(파싱 가능한, null이 아닌) 값의 min/max로 동기화 시점에 계산해
  // 캐싱한다 — 가격 정보가 하나도 없으면 0이 아니라 null로 유지한다.
  minPrice  Int?    @map("min_price") // 만원 단위
  maxPrice  Int?    @map("max_price") // 만원 단위
  pblancUrl String? @map("pblanc_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  houseTypeDetails PresaleHouseTypeDetail[]

  @@index([receiptStartDate, receiptEndDate])
  @@map("presales")
}

// 청약홈 getAPTLttotPblancMdl(주택형별 상세조회) 데이터를 저장한다. Presale(1) : 이 모델(N).
// P2-A에서 실제 4개 공고 27개 row를 조사해 (houseManageNo, modelNo) 조합이 공고 내에서 항상
// 유니크함을 확인했다 — 이를 외부 API 데이터 중복방지 키로 쓴다. 하위 데이터는 부모 Presale
// 없이는 의미가 없는 순수 종속 데이터라(이 스키마의 Comment-Post 관계와 성격이 같음),
// 기존 프로젝트 관례(Comment.post → onDelete: Cascade)를 따라 Cascade로 결정했다 —
// 임의로 넣은 기본값이 아니라 기존 스키마 패턴을 확인한 뒤 내린 결정이다.
model PresaleHouseTypeDetail {
  id        Int     @id @default(autoincrement())
  presaleId Int     @map("presale_id")
  presale   Presale @relation(fields: [presaleId], references: [id], onDelete: Cascade)

  houseManageNo String  @map("house_manage_no") // 부모 Presale.houseManageNo와 동일(조인 편의 + API 원본 키 보존)
  modelNo       String  @map("model_no") // "01", "02" ... 공고 내 유니크(P2-A 확인)
  houseTy       String? @map("house_ty") // 주택형 원본 코드(예: "055.9700A")
  supplyArea    Float?  @map("supply_area") // 공급면적(㎡), SUPLY_AR

  // 일반공급/특별공급 세대수 — API 원본 필드(SUPLY_HSHLDCO/SPSPLY_HSHLDCO) 그대로 보존.
  // 0은 "해당 유형 공급 없음"이라는 실제 값이므로 null과 구분한다(P2-A 확인).
  generalSupply Int? @map("general_supply")
  specialSupply Int? @map("special_supply")
  // totalSupply는 API 원본 필드가 아니라 generalSupply+specialSupply의 단순 합산이다(두
  // 값 다 있을 때만 계산, 하나라도 없으면 null) — 원본에 없는 값을 추측한 것이 아니라 실제
  // 저장된 두 숫자의 산술 합에 불과함을 분명히 한다. 필드 간 합계가 실제 API의 다른 값과
  // 어긋나더라도 임의로 보정하지 않는다.
  totalSupply   Int? @map("total_supply")

  // 해당 주택형의 분양 최고가(상한액). 만원 단위(P2-A 실측 교차검증으로 확정). 값이 없거나
  // 파싱 불가능하면 0이 아니라 null로 저장한다.
  topAmount Int? @map("top_amount")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([houseManageNo, modelNo])
  @@index([presaleId])
  @@map("presale_house_type_details")
}

// ══════════════════════════════════════════════════════════════════════════
// 실시간 트래킹 & 관리자 대시보드
// ══════════════════════════════════════════════════════════════════════════

// 페이지 이동/아파트 상세 진입 로그. 인기 단지 랭킹(누적)과 오늘 PV 집계에 쓰인다.
model PageView {
  id        Int      @id @default(autoincrement())
  url       String
  complexId String?  @map("complex_id") // 아파트 상세일 때: `${lawdCd}|${dong}|${name}` 형태의 안정적 식별자
  aptName   String?  @map("apt_name")
  sessionId String   @map("session_id") // 클라이언트가 생성해 sessionStorage에 들고 있는 익명 세션 ID
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([aptName, createdAt])
  @@index([sessionId, createdAt])
  @@map("page_views")
}

// 검색어 로그(AI 검색 + 일반 검색 공통). 인기 검색어 TOP 10 집계에 쓰인다.
model SearchLog {
  id        Int      @id @default(autoincrement())
  query     String
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("search_logs")
}

// 실시간 접속자/인기 단지 판정용 하트비트. sessionId 1건당 최신 상태 1행만 유지(upsert) —
// lastSeenAt이 30초 이내면 "지금 접속 중", currentAptName이 있으면 "지금 이 단지를 보는 중"
// 으로 간주한다. 별도 소켓 서버 없이 단순 폴링/upsert로 구현한다(이 앱의 기존 관례 —
// 외부 실시간 인프라를 새로 두지 않고 짧은 TTL 폴링으로 "실시간"을 흉내내는 방식).
model ActiveSession {
  sessionId      String   @id @map("session_id")
  userId         String?  @map("user_id")
  currentUrl     String?  @map("current_url")
  currentAptName String?  @map("current_apt_name")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")

  @@index([lastSeenAt])
  @@index([currentAptName, lastSeenAt])
  @@map("active_sessions")
}

// 백엔드/프론트엔드 에러 모니터링. 전역 계측(모든 API route try/catch, 클라이언트
// window.onerror)까지는 이 세션에서 다 걸지 못했고, 아래 log/error 엔드포인트와
// 최소 연동 지점만 우선 연결해뒀다 — 그래도 스키마/조회 API는 실제로 쌓인 값만
// 보여주므로 카드에 뜨는 숫자는 항상 진짜다(0건이면 정말 0건).
model ErrorLog {
  id        Int      @id @default(autoincrement())
  source    String // 'client' | 'server'
  message   String   @db.Text
  stack     String?  @db.Text
  url       String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("error_logs")
}

// 커뮤니티 신고 — 아직 유저가 신고를 접수하는 UI는 없어 이 테이블은 현재 항상 비어
// 있다(그래서 대시보드의 "미처리 신고 건수"는 실제로 항상 0으로 나온다). 신고 버튼을
// 나중에 붙일 때 이 테이블에 INSERT만 하면 대시보드 카드가 바로 실제 값을 반영한다.
model Report {
  id         Int      @id @default(autoincrement())
  postId     String?  @map("post_id")
  commentId  String?  @map("comment_id")
  reporterId String?  @map("reporter_id")
  reason     String?  @db.Text
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([resolved, createdAt])
  @@map("reports")
}
