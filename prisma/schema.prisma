generator client {
  provider = "prisma-client-js"
}

// Supabase(PostgreSQL)를 데이터베이스로 사용한다. DATABASE_URL은 .env에서 설정.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  USER
  VERIFIED
  ADMIN
}

// NextAuth의 AdapterUser 타입 계약(name/image 필드)을 그대로 만족시키면서도,
// 실제 DB 컬럼명은 요청된 대로 nickname/avatar_url이 되도록 @map으로 매핑한다.
// (Prisma Client 상의 속성명은 name/image, DB 컬럼명은 nickname/avatar_url)
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  name          String    @map("nickname")
  image         String?   @map("avatar_url")
  role          Role      @default(USER)
  // 관리자가 커뮤니티 이용을 제한(강퇴)한 계정. 로그인 자체는 막지 않되,
  // 글/댓글 작성 등 커뮤니티 활동을 차단하는 데 사용한다.
  banned        Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts Account[]
  sessions Session[]
  posts    Post[]
  comments Comment[]

  favorites      Favorite[]
  recentViews    RecentView[]
  userPreference UserPreference?

  @@map("users")
}

// NextAuth(Auth.js) PrismaAdapter가 요구하는 표준 스키마
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  // 관리자 권한으로 게시글을 목록 상단에 고정
  pinned    Boolean  @default(false)
  // 단지 상세페이지에서 연동되는 커뮤니티 글 태그 — 자유 텍스트, 정확 일치로만 필터링
  aptName   String?  @map("apt_name")
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author   User      @relation(fields: [authorId], references: [id])
  comments Comment[]

  @@index([pinned, createdAt])
  @@index([aptName, createdAt])
  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([postId])
  @@map("comments")
}

// ── 기존 실거래가 시드/오프라인 스크립트용 모델 (라이브 앱에서는 사용하지 않음) ──
model Transaction {
  id          Int      @id @default(autoincrement())
  rank        Int
  name        String
  price       String
  priceChange String
  changeType  String // "up" or "new"
  typeLabel   String // "반등" or "신고가"
  info        String // "73.27m² 25평 • 26.07.18"
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now())
}

model TradeHistory {
  id        Int      @id @default(autoincrement())
  aptName   String
  tradeDate String
  price     Int // 억 단위 저장 (예: 53)
  priceStr  String // 노출용 (예: 53억 2,000만)
  area      String
  floor     Int
  tradeType String // 중개거래, 직거래
  createdAt DateTime @default(now())

  @@index([aptName])
}

// scripts/crawl_facilities.py가 오프라인으로 채우는 단지 커뮤니티 시설 정보.
// 실거래가처럼 실시간 API가 있는 데이터가 아니라, 스크립트가 주기적으로 수집해
// 미리 채워둔 값을 상세페이지가 그대로 읽어 보여준다.
model Apartment {
  id                  Int                 @id @default(autoincrement())
  name                String
  dong                String?
  lawdCd              String?             @map("lawd_cd")
  // 이모지 태그 배열, 예: ["⛳ 골프연습장", "🏊 수영장"]. 정보가 없으면 null(빈 배열이 아님 —
  // "조사했지만 시설이 하나도 없다"와 "아직 조사 전"을 구분하기 위함).
  communityFacilities Json?               @map("community_facilities")
  // 건축물대장 표제부 공공데이터 기반. null은 "아직 조회 전/실패", 0은 취급하지 않는다
  // (총주차대수 0대·용적률 0%는 실제로 있을 수 없는 값이라 항상 "미확보"로 간주 — 조회
  // 로직도 0 이하 값은 저장하지 않는다).
  parkingCount        Int?                @map("parking_count")
  far                 Float?              @map("far") // 용적률(%)
  bcr                 Float?              @map("bcr") // 건폐율(%)
  // 총괄표제부 응답에 세대수도 같이 들어있어 캐싱해둔다. 네이버 스크래핑(비결정적 —
  // 매 요청 성공을 보장 못 함)에만 의존하면, parkingCount/far/bcr가 캐시 히트라 라이브
  // 조회를 건너뛴 요청에서는 세대수만 빠지는 문제가 실측으로 확인됐다.
  totalHouseholds     Int?                @map("total_households")
  // 총괄표제부 useAprDay(사용승인일)를 "YYYY년"으로 캐싱. 세대수와 같은 이유(네이버
  // 스크래핑은 검색어에 지역 정보가 없어 동명의 타 지역 단지 값을 가져올 수 있음 —
  // 실측: "금호어울림"으로 검색 시 부산 서구(256세대)가 아닌 타 단지의 "1,549세대"가
  // 잡힘)로, 지번까지 정확히 지정해 조회하는 건축물대장 값을 우선한다.
  approvalDate        String?             @map("approval_date")
  // 건축물대장 총괄표제부 조회에 필요한 지번(예: "1544"). 이 값 없이는 동 전체를
  // 뒤져야 하는데, 실측 결과 그 방식은 신뢰할 수 없는 결과(엉뚱한 건물)만 반환해서
  // jibun을 사실상 필수로 요구하게 됐다 — apt-client.tsx가 실거래 데이터에서 얻은
  // jibun으로 /api/apt/[name]/info를 호출할 때마다 여기 저장해, 다음부터는 배치
  // 스크립트도 이 값을 재사용할 수 있게 한다.
  jibun               String?             @map("jibun")
  // STEP SCORE S2A — ApartmentMaster.aptSeq(정식 identity, M3/M4)와 연결하는 backfill용
  // 필드. unique를 걸지 않는다: 32건 매칭 감사(SCORE-S2A 문서 §3) 결과 "대신더샵"/
  // "대신더샵아파트"처럼 이름 표기만 다른 Apartment row 2건이 같은 aptSeq로 매칭되는
  // 실제 사례가 4쌍 확인됐다 — Apartment.@@unique([name, dong])가 문자열 표기 차이를
  // 막지 못해 생긴 기존 중복이며, 이번 STEP에서 그 중복 자체를 정리하지는 않는다(범위
  // 밖). AMBIGUOUS/UNMATCHED로 분류된 row는 이 필드를 채우지 않는다(강제 연결 금지).
  aptSeq              String?             @map("apt_seq")
  // @default(now())를 같이 둬서, Prisma를 거치지 않고 scripts/crawl_facilities.py가
  // Supabase REST API로 직접 INSERT할 때도(이 컬럼 값을 안 보내도) DB가 자동으로 채운다.
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at")
  unitTypes           ApartmentUnitType[]

  @@unique([name, dong])
  @@index([aptSeq])
  @@map("apartments")
}

// MASTER M1/M2(docs/development/11-apartment-master-analysis.md,
// 12-apartment-master-design.md)에서 설계한 Apartment Master — MASTER M3(소량 실제
// 구축 검증) 대상 신규 모델. 기존 Apartment(위, 건축물대장 캐시 20건)를 대체하지 않고
// 병행한다 — 이번 STEP에서는 기존 코드가 이 모델을 사용하도록 전환하지 않는다.
//
// 한 행 = MOLIT aptSeq 1개(M2 §C 결론). 이름/동 문자열 매칭이 아니라 aptSeq(있으면)를
// 우선 식별자로 쓰고, normalizedName은 검색 보조용일 뿐 identity로 쓰지 않는다(M2 §I).
model ApartmentMaster {
  id Int @id @default(autoincrement())

  // 외부 식별자 — 내부 PK(id)와 분리, 둘 다 nullable(무거래/미확보 단지 수용, M2 §R)
  aptSeq       String? @unique @map("apt_seq") // MOLIT, "{lawdCd}-{일련번호}"
  // 건축물대장 총괄표제부 관리번호. 정수로 다루면 정밀도 손실 위험이 있어 문자열로만
  // 저장한다(M1 §K). 한 단지에 총괄표제부가 여러 건 잡히는 드문 사례가 있음이 기존
  // apt-building-info.ts 주석에서 이미 확인돼, DB unique 제약은 걸지 않는다(M3 §5).
  mgmBldrgstPk String? @map("mgm_bldrgst_pk")

  name           String // MOLIT aptNm 또는 건축물대장 bldNm 원본 표기
  normalizedName String @map("normalized_name") // 공백/"아파트" 접미사 제거 — 매칭 보조용

  // 지역/주소 — 원본 필드를 분리 보존한다(단일 텍스트 컬럼으로 뭉치지 않음, M2 §H)
  sido         String?
  sigungu      String?
  sggCd        String? @map("sgg_cd") // = lawdCd, MOLIT 원본
  umdName      String? @map("umd_name")
  umdCd        String? @map("umd_cd")
  jibun        String?
  roadAddress  String? @map("road_address") // 건축물대장 newPlatPlc(도로명주소 완성형)
  jibunAddress String? @map("jibun_address") // 건축물대장 platPlc(지번주소 완성형)

  // 좌표 — Kakao geocoding만 원천(M2 §I). area_only(행정구역 대표좌표)는 저장하지 않는다.
  latitude       Float?
  longitude      Float?
  geocodeQuality String? @map("geocode_quality") // 'exact' | 'normalized' | 'failed'

  // 건물 정보 — 단지 총괄 값으로 확정 가능한 것만 저장(동 단위 값을 단지 전체처럼 저장 금지).
  // DATA_COVERAGE_FIX_V1부터 totalHouseholds/parkingCount는 총괄표제부 확정값 또는 표제부
  // fallback(지번 내 건물 정확히 1건일 때만, APARTMENT_BASIC_DATA_COVERAGE_AUDIT_V1 근거)
  // 둘 중 하나에서 온다 — 어느 쪽인지는 basicSpecSource로 구분한다.
  buildYear         Int?    @map("build_year") // MOLIT 건축년도(참고용)
  useApprovalDate   String? @map("use_approval_date") // 건축물대장 useAprDay 원본("YYYYMMDD")
  mainBuildingCount Int?    @map("main_building_count") // 건축물대장 mainBldCnt(동수, 총괄표제부 전용 — 표제부 fallback엔 없음)
  totalHouseholds   Int?    @map("total_households") // 건축물대장 hhldCnt
  parkingCount      Int?    @map("parking_count") // 총괄표제부 totPkngCnt 또는 표제부 4필드(옥내외×자주기계식) 합산

  // DATA_COVERAGE_FIX_V1 신규 — 기존 Apartment.far/bcr과 동일하게 Float(기존 프로젝트
  // convention 재사용, 535.3/59.82 같은 소수 1~2자리 percent 값에 정밀도 손실 없음이
  // Apartment 테이블에서 이미 실증됨). 0 이하/무효값은 저장하지 않는다(null = 미확보,
  // 0을 실제 0으로 저장 금지 — 프로젝트 전역 데이터 신뢰 원칙).
  floorAreaRatio        Float? @map("floor_area_ratio") // 용적률(%)
  buildingCoverageRatio Float? @map("building_coverage_ratio") // 건폐율(%)
  // parkingCount / totalHouseholds, totalHouseholds > 0일 때만 계산해 저장(추정치 아님 —
  // 이미 저장된 두 확정값의 단순 나눗셈). 매 응답마다 다시 계산하지 않도록 backfill 시점에
  // 함께 저장한다.
  parkingPerHousehold   Float? @map("parking_per_household")

  basicSpecSource BasicSpecSource @default(UNKNOWN) @map("basic_spec_source")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([sggCd])
  @@index([normalizedName])
  @@index([umdCd, jibun])
  @@map("apartment_masters")
}

// ══════════════════════════════════════════════════════════════════════════
// STEP SCORE S2A — 이집점수(Apartment Score) feature 캐시. docs/development/
// SCORE-S1/S1.1/S2A 설계 결론 적용. 이 두 테이블에는 "원본 수치(raw feature)"만
// 저장하고 점수/가중치/등급은 절대 저장하지 않는다(S1 §금지 원칙, S1.1 §RAW≠SCORE
// 원칙 그대로 유지) — totalScore/transportScore 같은 컬럼은 이 스키마에 없다.
// 점수 계산은 서버 전용 코드(src/lib/apartment-score/server/)에서 이 raw 값을
// 매 요청마다 다시 계산하며, 계산된 값 자체는 DB에 남기지 않는다.
//
// PK로 aptSeq(ApartmentMaster.aptSeq와 동일한 값)를 그대로 쓴다 — 이 프로젝트에
// 이미 자연키를 @id로 쓰는 선례가 있다(ActiveSession.sessionId). ApartmentMaster로의
// formal FK(@relation)는 걸지 않는다 — RedevelopmentProject.source를 enum이 아닌
// String으로 남긴 것과 같은 이유(R3B 설계 결정 재사용): ApartmentMaster는 M-시리즈
// 배치가 주기적으로 재구축하는 테이블이라, 내부 PK(id)가 재생성될 가능성이 있는
// 반면 aptSeq 값 자체는 안정적이다 — 값 기반의 느슨한 연결을 유지한다.
// ══════════════════════════════════════════════════════════════════════════

// 위치 기반 raw feature — 좌표 1개당 Kakao Local API/TAGO로 조사 가능한 반경 내
// 개수·최단거리만 저장한다. "학군"(학업성취도)이나 "오션뷰"처럼 데이터 자체가
// 존재하지 않는 항목은 필드를 만들지 않는다(SCORE-S1 §6, S1.1 §해변접근성/오션뷰
// 분리 원칙) — 여기 있는 모든 필드는 이미 이 프로젝트가 실제로 쓰고 있는 API
// 응답에서 그대로 뽑을 수 있는 값이다(KakaoPlaces.tsx/BusAccessCard.tsx/
// NeighborhoodInfoPanel.tsx가 이미 production에서 쓰는 카테고리와 동일).
model ApartmentLocationFeature {
  aptSeq String @id @map("apt_seq") // ApartmentMaster.aptSeq와 동일 값(문자열 매칭, FK 아님)

  latitude  Float
  longitude Float

  // 교통 — 지하철(Kakao SW8), 버스(TAGO, /api/transit/bus-stops가 이미 재사용 가능)
  nearestSubwayDistanceM  Int?    @map("nearest_subway_distance_m")
  nearestSubwayName       String? @map("nearest_subway_name")
  subwayCount1000m        Int?    @map("subway_count_1000m")
  nearestBusStopDistanceM Int?    @map("nearest_bus_stop_distance_m")
  busStopCount300m        Int?    @map("bus_stop_count_300m")

  // 생활편의 — Kakao 카테고리 코드 그대로(MT1/CS2/PM9/HP8), 키워드+category_name
  // 필터링(공원)까지 이미 KakaoPlaces.tsx/NeighborhoodInfoPanel.tsx에서 검증된 방식
  martCount1000m               Int? @map("mart_count_1000m")
  convenienceCount500m         Int? @map("convenience_count_500m")
  pharmacyCount500m            Int? @map("pharmacy_count_500m")
  hospitalCount1000m           Int? @map("hospital_count_1000m")
  parkCount1000m               Int? @map("park_count_1000m")
  // Kakao PS3는 어린이집·유치원을 공식적으로 하나로 묶어 분류한다(둘을 분리할 수
  // 없음, KakaoPlaces.tsx 기존 확인 사실) — 필드명도 그 사실을 정확히 반영한다.
  daycareKindergartenCount500m Int? @map("daycare_kindergarten_count_500m")

  // 학교 "접근성"만 — 학군(학업성취도) 데이터는 어디에도 없다(SchoolDistrictPanel.tsx
  // 기존 주석, STEP1.5-A/STEP50에서 이미 확정된 사실 재확인, 새로 만들지 않음)
  nearestElementaryDistanceM Int? @map("nearest_elementary_distance_m")
  elementaryCount1000m       Int? @map("elementary_count_1000m")

  // 지역 프리미엄(Regional Location Premium) 원재료 — "해변 접근성"만 저장한다.
  // "오션뷰"는 층/향/차폐 데이터가 없어 계산 불가(S1.1 결론) — 컬럼 자체를 만들지
  // 않는다. Kakao 키워드 검색("해수욕장") + category_name 필터로 계산(S1.1 §검증).
  beachDistanceM Int? @map("beach_distance_m")

  source        String    @default("kakao_local_api") @map("source")
  sourceVersion String?   @map("source_version")
  fetchedAt     DateTime  @map("fetched_at")
  validUntil    DateTime? @map("valid_until")
  // 'complete' | 'partial' | 'stale' — 수집 스크립트(S2B)가 일부 카테고리 호출만
  // 실패했을 때 그 사실을 정직하게 남기기 위함(전부 성공한 것처럼 위장하지 않음)
  qualityFlag   String    @default("complete") @map("quality_flag")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("apartment_location_features")
}

// 시세 raw feature — MOLIT 실거래 원본(fetchMolitData)에서 이 아파트로 매칭된
// 거래 건만 집계한 값만 저장한다. "가격 경쟁력 점수" 같은 계산값은 없다.
// medianPricePerM2_*는 개별 거래 row의 거래가/전용면적으로 계산 가능하나(단지
// 전체의 단일 면적값이 필요한 게 아님 — SCORE-S1.1에서 우려했던 "ApartmentMaster에
// area 필드 없음" 문제와는 다른 층위), 실제 MOLIT 응답의 면적 필드 결측률은 이번
// STEP에서 확인하지 않았다 — S2B 수집 스크립트 구현 시 최초 확인 필요
// (EXTERNAL_VERIFICATION_REQUIRED, S1.1과 동일한 표기 원칙).
model ApartmentMarketFeature {
  aptSeq String @id @map("apt_seq")

  latestTradePrice     Int?      @map("latest_trade_price") // 만원 단위(기존 Presale.minPrice 관례 재사용)
  latestTradeDate      DateTime? @map("latest_trade_date")
  medianPricePerM2_12m Int?      @map("median_price_per_m2_12m")
  medianPricePerM2_36m Int?      @map("median_price_per_m2_36m")
  transactionCount12m  Int?      @map("transaction_count_12m")
  transactionCount36m  Int?      @map("transaction_count_36m")
  // 12개월 전 median 대비 현재 median의 증감률(%) — 원본 수치의 산술 비교일 뿐,
  // "투자가치 점수"가 아니다(PresaleHouseTypeDetail.totalSupply와 같은 성격 —
  // 원본에 없는 값을 추측한 게 아니라 저장된 두 숫자의 산술 비교).
  priceChange12m       Float?    @map("price_change_12m")

  source        String    @default("molit") @map("source")
  sourceVersion String?   @map("source_version")
  fetchedAt     DateTime  @map("fetched_at")
  validUntil    DateTime? @map("valid_until")
  qualityFlag   String    @default("complete") @map("quality_flag")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("apartment_market_features")
}

// AI 검색(/api/ai-search)의 의도 분류 + 최종 응답을 캐싱해 동일한 질문에 Gemini를
// 다시 호출하지 않게 한다(토큰 비용 절감 + 응답 속도). 정규화된 질문 문자열의 해시를
// 키로 쓴다 — 완전히 같은 문장일 때만 히트하는 단순한 캐시라, 유사하지만 다른 표현의
// 질문은 캐시되지 않고 새로 호출된다(요청된 범위 그대로).
model AiSearchCache {
  id        Int      @id @default(autoincrement())
  queryHash String   @unique @map("query_hash")
  query     String   @db.Text
  intent    String
  // Gemini 브리핑 텍스트 + 조회된 실제 데이터(리스트/통계/비교표)를 함께 저장 — 캐시
  // 히트 시 이 하나만 읽으면 프론트가 바로 렌더링할 수 있다.
  result    Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_search_cache")
}

// ══════════════════════════════════════════════════════════════════════════
// 오피스텔/생활형숙박시설(생숙)/재개발 — 데이터 수집 기반(스키마 + 파이프라인 스텁)
// ══════════════════════════════════════════════════════════════════════════

enum PropertyCategory {
  APT
  OFFICETEL
  LIVING_STAY
  REDEVELOPMENT
}

// 기존 Apartment 모델은 "MOLIT 아파트 실거래 매칭용 건축물대장 캐시"라는 좁은 용도로
// 이미 unique([name, dong])와 아파트 전용 조회 로직에 강하게 묶여 있어(apt-building-info.ts,
// api/apt/[name] 등 여러 곳이 이 제약을 전제로 함), 성격이 다른 오피스텔/생숙/재개발을
// 억지로 얹으면 기존 아파트 매칭 로직이 깨질 위험이 크다. category로 구분되는 범용
// 매물 테이블을 새로 둔다 — 실제 데이터 수집(services/publicDataService.ts)이 채워지기
// 전까지는 빈 테이블이며, /api/properties가 그대로 빈 배열을 정직하게 반환한다.
model Property {
  id              Int              @id @default(autoincrement())
  category        PropertyCategory
  name            String
  dong            String?
  lawdCd          String?          @map("lawd_cd")
  totalHouseholds Int?             @map("total_households")
  totalParking    Int?             @map("total_parking")
  buildYear       Int?             @map("build_year")
  approvalDate    String?          @map("approval_date")
  lat             Float?
  lng             Float?
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")

  @@unique([category, name, dong])
  @@index([category])
  @@map("properties")
}

// ═══════════════════════════════════════════════════════════
// STEP R4 — docs/development/R3B-redevelopment-master-schema-design.md
// 확정안 적용. 기존 RedevelopmentProject/RedevelopmentStage(단일 테이블,
// production 0건 확인)를 대체 — 원본 SourceRecord와 canonical Project를
// 분리한 2-엔티티 구조로 국토부/부산 등 복수 source를 안전하게 병합한다.
// ═══════════════════════════════════════════════════════════

enum RedevelopmentBusinessType {
  REDEVELOPMENT
  RECONSTRUCTION
  RESIDENTIAL_ENVIRONMENT
  SMALL_RECONSTRUCTION
  BLOCK_HOUSING
  OTHER
  UNKNOWN
}

enum RedevelopmentStage {
  PLANNED
  ZONE_DESIGNATED
  PROMOTION_COMMITTEE
  ASSOCIATION_APPROVED
  ARCHITECTURAL_REVIEW
  PUBLIC_OPERATOR_DESIGNATED
  PROJECT_IMPLEMENTATION_APPROVED
  MANAGEMENT_DISPOSITION_APPROVED
  RELOCATION_DEMOLITION
  CONSTRUCTION
  COMPLETED
  TRANSFER_REGISTERED
  DISSOLVED
  CANCELLED
  UNKNOWN
}

enum RedevelopmentProjectStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  UNKNOWN
}

enum RedevelopmentLocationType {
  PROJECT_SITE
  OFFICE
  APPROXIMATE
  UNKNOWN
}

enum RedevelopmentLocationConfidence {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum RedevelopmentGeocodeStatus {
  NOT_ATTEMPTED
  SUCCESS
  AMBIGUOUS
  FAILED
}

enum RedevelopmentMatchConfidence {
  EXACT
  HIGH
  MEDIUM
  LOW
  UNMATCHED
}

enum RedevelopmentMergeStatus {
  AUTO_MATCHED
  REVIEW_REQUIRED
  MANUAL_MATCHED
  UNMATCHED
}

model RedevelopmentProject {
  id Int @id @default(autoincrement())

  canonicalName  String @map("canonical_name")
  normalizedName String @map("normalized_name")

  sido    String
  sigungu String

  businessType  RedevelopmentBusinessType  @default(UNKNOWN) @map("business_type")
  stage         RedevelopmentStage         @default(UNKNOWN)
  projectStatus RedevelopmentProjectStatus @default(UNKNOWN) @map("project_status")

  householdCount Int? @map("household_count")

  lat                Float?
  lng                Float?
  locationType       RedevelopmentLocationType?       @map("location_type")
  locationConfidence RedevelopmentLocationConfidence? @map("location_confidence")
  geocodeStatus      RedevelopmentGeocodeStatus?      @map("geocode_status")
  geocodeSource      String?                          @map("geocode_source")

  // V2 polygon placeholder — geometry 컬럼은 아직 만들지 않음(R3B 참고).
  polygonSource String? @map("polygon_source")
  polygonRef    String? @map("polygon_ref")

  primarySource   String    @map("primary_source")
  sourceUpdatedAt DateTime? @map("source_updated_at")
  collectedAt     DateTime  @map("collected_at")

  needsReview Boolean @default(false) @map("needs_review")

  sourceRecords RedevelopmentSourceRecord[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sido, sigungu])
  @@index([businessType])
  @@index([stage])
  @@index([normalizedName])
  @@map("redevelopment_projects")
}

model RedevelopmentSourceRecord {
  id        Int                  @id @default(autoincrement())
  projectId Int                  @map("project_id")
  project   RedevelopmentProject @relation(fields: [projectId], references: [id])

  source         String
  sourceRecordId String @map("source_record_id")

  rawName             String  @map("raw_name")
  rawBusinessType     String? @map("raw_business_type")
  rawBusinessTypeCode String? @map("raw_business_type_code")
  rawStage            String? @map("raw_stage")
  rawStageCode        String? @map("raw_stage_code")
  rawHouseholdCount   String? @map("raw_household_count")
  rawLocation         String? @map("raw_location")

  rawPayload Json? @map("raw_payload")

  matchConfidence RedevelopmentMatchConfidence? @map("match_confidence")
  mergeStatus     RedevelopmentMergeStatus      @default(UNMATCHED) @map("merge_status")

  sourceUpdatedAt DateTime? @map("source_updated_at")
  collectedAt     DateTime  @map("collected_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([source, sourceRecordId])
  @@index([projectId])
  @@map("redevelopment_source_records")
}

// ══════════════════════════════════════════════════════════════════════════
// 분양/청약 — 청약홈 연동 기반(스키마 + 파이프라인 스텁)
// ══════════════════════════════════════════════════════════════════════════

enum PresaleHouseType {
  APT
  OFFICETEL
  URBAN // 도시형생활주택
  REMAIN // 잔여세대(무순위)
}

model Presale {
  id                    Int              @id @default(autoincrement())
  houseManageNo         String?          @unique @map("house_manage_no") // 주택관리번호(청약홈 PK)
  pblancNo              String?          @map("pblanc_no") // 공고번호 — houseManageNo와 항상 같다고 가정하지 않고 원본 그대로 별도 보존(P2-A 확인)
  houseName             String           @map("house_name")
  // 기존 4종 enum. 이번 P2-B에서는 삭제/대규모 변경하지 않는다(호환성 유지용 최소 매핑만 수행).
  // 공식 API 원본 분류값은 houseSecd/houseSecdName에 별도로 보존한다 — P2-A 확인 결과 이
  // enum이 기대하는 "오피스텔"/"도시형생활주택" 값은 getAPTLttotPblancDetail(APT 전용
  // endpoint)만으로는 원천적으로 나오지 않는다(별도 API 계열 필요, 향후 통합 정책 결정 대상).
  houseType             PresaleHouseType @map("house_type")
  // 공식 API 원본 주택유형 코드/명칭(예: "01"/"APT", "10"/"신혼희망타운") — houseType enum과
  // 별개로, 원본 값을 훼손 없이 그대로 보존한다.
  houseSecd             String?          @map("house_secd")
  houseSecdName         String?          @map("house_secd_name")
  // 분양/임대 구분 원본값(예: "0"/"분양주택", "1"/"분양전환 가능임대") — 임의로 분양/임대
  // 2분류로 축소하지 않고 원본 그대로 보존한다(P2-A 확인).
  rentSecd              String?          @map("rent_secd")
  rentSecdName          String?          @map("rent_secd_name")
  locationAddress       String?          @map("location_address")
  // 공급지역(시/도 단위) 코드/명칭 — SUBSCRPT_AREA_CODE/SUBSCRPT_AREA_CODE_NM. 시군구까지는
  // 세분화되어 있지 않다(P2-A 확인) — 시군구 단위 필터는 locationAddress 파싱이 별도로 필요.
  subscriptionAreaCode  String?          @map("subscription_area_code")
  subscriptionAreaName  String?          @map("subscription_area_name")
  latitude              Float?
  longitude             Float?
  totalSupplyHouseholds Int?             @map("total_supply_households")
  constructCompany      String?          @map("construct_company")
  // 사업주체(시행사) — 시공사(constructCompany)와 별개 개념, API 원본 BSNS_MBY_NM.
  businessEntityName    String?          @map("business_entity_name")

  announcementDate  DateTime? @map("announcement_date")
  // RCEPT_BGNDE/RCEPT_ENDDE에 매핑한다 — P2-A에서 이 두 필드가 특별공급/1·2순위·지역별
  // 세분화 접수기간 9종의 min/max와 50건 전수 정확히 일치함을 확인했으므로, 별도로
  // min/max를 계산하지 않고 API가 제공하는 이 값을 그대로 사용한다.
  receiptStartDate  DateTime? @map("receipt_start_date")
  receiptEndDate    DateTime? @map("receipt_end_date")
  winnerDate        DateTime? @map("winner_date")
  // 계약기간(CNTRCT_CNCLS_BGNDE/ENDDE) — P2-A 확인 결과 완결성이 높아(표본 50/50 non-null)
  // 저장 가치가 있다고 판단됨.
  contractStartDate DateTime? @map("contract_start_date")
  contractEndDate   DateTime? @map("contract_end_date")
  // 입주예정월(MVN_PREARNGE_YM) — "YYYYMM" 6자리 원본 문자열 그대로 보존한다. 일자 정보가
  // 없는 값을 DateTime으로 강제 변환(임의로 1일을 채우는 등)하지 않는다(P2-A 정책 확정).
  moveInExpectedYm  String?   @map("move_in_expected_ym")

  // 만원 단위(P2-A에서 실제 공고 3건을 언론 보도와 교차검증해 확정). PresaleHouseTypeDetail의
  // topAmount 값들 중 유효한(파싱 가능한, null이 아닌) 값의 min/max로 동기화 시점에 계산해
  // 캐싱한다 — 가격 정보가 하나도 없으면 0이 아니라 null로 유지한다.
  minPrice  Int?    @map("min_price") // 만원 단위
  maxPrice  Int?    @map("max_price") // 만원 단위
  pblancUrl String? @map("pblanc_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  houseTypeDetails PresaleHouseTypeDetail[]

  @@index([receiptStartDate, receiptEndDate])
  @@map("presales")
}

// 청약홈 getAPTLttotPblancMdl(주택형별 상세조회) 데이터를 저장한다. Presale(1) : 이 모델(N).
// P2-A에서 실제 4개 공고 27개 row를 조사해 (houseManageNo, modelNo) 조합이 공고 내에서 항상
// 유니크함을 확인했다 — 이를 외부 API 데이터 중복방지 키로 쓴다. 하위 데이터는 부모 Presale
// 없이는 의미가 없는 순수 종속 데이터라(이 스키마의 Comment-Post 관계와 성격이 같음),
// 기존 프로젝트 관례(Comment.post → onDelete: Cascade)를 따라 Cascade로 결정했다 —
// 임의로 넣은 기본값이 아니라 기존 스키마 패턴을 확인한 뒤 내린 결정이다.
model PresaleHouseTypeDetail {
  id        Int     @id @default(autoincrement())
  presaleId Int     @map("presale_id")
  presale   Presale @relation(fields: [presaleId], references: [id], onDelete: Cascade)

  houseManageNo String  @map("house_manage_no") // 부모 Presale.houseManageNo와 동일(조인 편의 + API 원본 키 보존)
  modelNo       String  @map("model_no") // "01", "02" ... 공고 내 유니크(P2-A 확인)
  houseTy       String? @map("house_ty") // 주택형 원본 코드(예: "055.9700A")
  supplyArea    Float?  @map("supply_area") // 공급면적(㎡), SUPLY_AR

  // 일반공급/특별공급 세대수 — API 원본 필드(SUPLY_HSHLDCO/SPSPLY_HSHLDCO) 그대로 보존.
  // 0은 "해당 유형 공급 없음"이라는 실제 값이므로 null과 구분한다(P2-A 확인).
  generalSupply Int? @map("general_supply")
  specialSupply Int? @map("special_supply")
  // totalSupply는 API 원본 필드가 아니라 generalSupply+specialSupply의 단순 합산이다(두
  // 값 다 있을 때만 계산, 하나라도 없으면 null) — 원본에 없는 값을 추측한 것이 아니라 실제
  // 저장된 두 숫자의 산술 합에 불과함을 분명히 한다. 필드 간 합계가 실제 API의 다른 값과
  // 어긋나더라도 임의로 보정하지 않는다.
  totalSupply   Int? @map("total_supply")

  // 해당 주택형의 분양 최고가(상한액). 만원 단위(P2-A 실측 교차검증으로 확정). 값이 없거나
  // 파싱 불가능하면 0이 아니라 null로 저장한다.
  topAmount Int? @map("top_amount")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([houseManageNo, modelNo])
  @@index([presaleId])
  @@map("presale_house_type_details")
}

// ══════════════════════════════════════════════════════════════════════════
// 실시간 트래킹 & 관리자 대시보드
// ══════════════════════════════════════════════════════════════════════════

// 페이지 이동/아파트 상세 진입 로그. 인기 단지 랭킹(누적)과 오늘 PV 집계에 쓰인다.
model PageView {
  id        Int      @id @default(autoincrement())
  url       String
  complexId String?  @map("complex_id") // 아파트 상세일 때: `${lawdCd}|${dong}|${name}` 형태의 안정적 식별자
  aptName   String?  @map("apt_name")
  sessionId String   @map("session_id") // 클라이언트가 생성해 sessionStorage에 들고 있는 익명 세션 ID
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([aptName, createdAt])
  @@index([sessionId, createdAt])
  @@map("page_views")
}

// 검색어 로그(AI 검색 + 일반 검색 공통). 인기 검색어 TOP 10 집계에 쓰인다.
model SearchLog {
  id        Int      @id @default(autoincrement())
  query     String
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("search_logs")
}

// 실시간 접속자/인기 단지 판정용 하트비트. sessionId 1건당 최신 상태 1행만 유지(upsert) —
// lastSeenAt이 30초 이내면 "지금 접속 중", currentAptName이 있으면 "지금 이 단지를 보는 중"
// 으로 간주한다. 별도 소켓 서버 없이 단순 폴링/upsert로 구현한다(이 앱의 기존 관례 —
// 외부 실시간 인프라를 새로 두지 않고 짧은 TTL 폴링으로 "실시간"을 흉내내는 방식).
model ActiveSession {
  sessionId      String   @id @map("session_id")
  userId         String?  @map("user_id")
  currentUrl     String?  @map("current_url")
  currentAptName String?  @map("current_apt_name")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")

  @@index([lastSeenAt])
  @@index([currentAptName, lastSeenAt])
  @@map("active_sessions")
}

// 백엔드/프론트엔드 에러 모니터링. 전역 계측(모든 API route try/catch, 클라이언트
// window.onerror)까지는 이 세션에서 다 걸지 못했고, 아래 log/error 엔드포인트와
// 최소 연동 지점만 우선 연결해뒀다 — 그래도 스키마/조회 API는 실제로 쌓인 값만
// 보여주므로 카드에 뜨는 숫자는 항상 진짜다(0건이면 정말 0건).
model ErrorLog {
  id        Int      @id @default(autoincrement())
  source    String // 'client' | 'server'
  message   String   @db.Text
  stack     String?  @db.Text
  url       String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("error_logs")
}

// 커뮤니티 신고 — 아직 유저가 신고를 접수하는 UI는 없어 이 테이블은 현재 항상 비어
// 있다(그래서 대시보드의 "미처리 신고 건수"는 실제로 항상 0으로 나온다). 신고 버튼을
// 나중에 붙일 때 이 테이블에 INSERT만 하면 대시보드 카드가 바로 실제 값을 반영한다.
model Report {
  id         Int      @id @default(autoincrement())
  postId     String?  @map("post_id")
  commentId  String?  @map("comment_id")
  reporterId String?  @map("reporter_id")
  reason     String?  @db.Text
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([resolved, createdAt])
  @@map("reports")
}

// ══════════════════════════════════════════════════════════════════════════
// SCHOOL V2-C1 — Education core schema(학교/유치원/어린이집). 설계는
// docs/development/SCHOOL-V2-C-education-data-architecture.md,
// NOW/LATER 최종 결정은 docs/development/SCHOOL-V2-C1-core-education-schema.md
// 참고. 이번 STEP은 스키마만 생성한다 — ingestion 코드는 없고, 아래 모든
// 테이블은 배포 직후 row 0건이 정상이다.
//
// 설계 원칙(SCHOOL V2-C §2/§5 결론 그대로):
// - School/Kindergarten/Childcare는 통합 폴리모픽 테이블로 만들지 않고
//   완전히 분리한다(Option B, ApartmentMaster/RedevelopmentProject처럼
//   단일 concrete 타입 + companion 테이블 컨벤션 재사용).
// - 학교명/유치원명 등 문자열을 canonical key로 쓰지 않는다 — 공식
//   기관코드(NEIS 학교코드/어린이집 시설코드)를 우선하고, 아직 코드
//   자체가 확인 안 된 유치원은 identityConfidence로 그 사실을 명시한다.
// - 세부 API field schema가 미확정인 항목(학년별 상세, 연령별 원아수
//   등)은 typed column을 만들지 않고 Json으로만 열어둔다 — 나중에
//   schema가 확정되면 별도 migration으로 typed column을 추가한다.
// - 폐교/폐원은 hard delete가 아니라 isActive=false로 표현한다
//   (공공기관 데이터의 일반적 성격 — SCHOOL V2-C §20).
// - Stat 테이블은 EducationSource로 formal relation을 건다(핵심
//   reference 테이블이라 배치 재구축 대상인 ApartmentMaster류와 달리
//   FK가 안전하다) — 반대로 EducationSource → Stat 방향은 onDelete를
//   지정하지 않아(Prisma 기본 Restrict) source row를 실수로 지워도
//   이미 적재된 기관/통계 데이터가 함께 사라지지 않는다.
// ══════════════════════════════════════════════════════════════════════════

enum EducationDataQuality {
  COMPLETE
  PARTIAL
  STALE
  IDENTITY_UNRESOLVED
  COORDINATE_APPROX
  SOURCE_ERROR
}

// 통계 한 행이 실제로 "그 라운드에 공시된 값"인지 아닌지를 숫자 필드의
// null/0 여부와 별개로 명시한다 — 0(진짜 0)과 null(미수집)과 "이번
// 라운드엔 공시 안 됨"과 "이 학교급엔 해당 없음"을 전부 구분하기 위함
// (SCHOOL V2-C §14/§27, CLAUDE.md 원칙 4 "데이터가 없으면 임의의 값을
// 생성하지 않는다"의 연장).
enum DisclosureStatus {
  AVAILABLE
  NOT_DISCLOSED
  NOT_APPLICABLE
  UNKNOWN
  SOURCE_ERROR
}

// 주소 중심좌표(지오코딩)와 실제 정문/출입구 좌표를 같은 값으로 취급하지
// 않기 위한 구분(SCHOOL V2-C §16) — 현재 확보 가능한 좌표는 전부 Kakao
// 지오코딩 기반이라 초기 데이터는 대부분 ADDRESS_GEOCODE 또는 UNKNOWN이다.
enum CoordinateType {
  OFFICIAL_POINT
  ADDRESS_GEOCODE
  ENTRANCE
  CENTER
  UNKNOWN
}

// EducationSource 하나가 상업적 서비스인 이집에서 실제로 써도 되는지의
// 게이트. ingestion 코드(이번 STEP에는 없음)는 반드시 CLEARED인 source만
// 적재해야 한다 — SCHOOL V2-B에서 확인된 LEGAL_REVIEW_REQUIRED source
// (학교알리미 API 경로, 유치원알리미 API 일부)를 이 필드로 코드 레벨에서
// 막기 위함(SCHOOL V2-C §21/§29).
enum LegalReviewStatus {
  UNKNOWN
  REVIEW_REQUIRED
  CLEARED
  BLOCKED
}

// 유치원 공식 기관코드 존재 여부 자체가 SCHOOL V2-B 조사에서 확인되지
// 않았다 — officialCode가 비어 있는 동안 이 row의 identity가 이름/주소
// 기반 임시값에 불과하다는 사실을 명시적으로 남기기 위한 필드.
enum IdentityConfidence {
  HIGH
  MEDIUM
  LOW
}

// 학교알리미/유치원알리미/어린이집 API 등 source별 메타데이터 + 법적
// 게이트 registry. 다른 모든 education 테이블의 provenance가 여기로
// 값 또는 FK로 연결된다 — source 자체를 여기 한 곳에서만 관리해
// 라이선스 재확인 시 여러 테이블을 뒤질 필요가 없게 한다.
model EducationSource {
  id          Int    @id @default(autoincrement())
  code        String @unique // 'neis' | 'schoolinfo_api' | 'schoolinfo_file' | 'kindergarten_moe_file' | 'kindergarten_api' | 'childcare_national_api' | ...
  displayName String @map("display_name") // 사용자 화면 표시용, 예: "학교알리미"

  provider   String? // 예: "한국교육학술정보원"
  datasetId  String? @map("dataset_id") // data.go.kr 데이터셋 id(있으면), 예: "15098092"
  sourceType String  @map("source_type") // 'API' | 'FILE' | 'STANDARD_DATASET' — ingestion 코드 분기용 자유 태그, enum으로 확정하지 않음(SCHOOL V2-C §13 "필요 최소만" 원칙)
  sourceUrl  String? @map("source_url")

  licenseCode          String?  @map("license_code") // 예: "KOGL-1", "KOGL-3", "UNRESTRICTED" — SCHOOL V2-B에서 확인된 값 그대로
  attributionRequired  Boolean  @default(true) @map("attribution_required")
  // null = 아직 확인 안 됨(UNKNOWN), false와 명확히 구분(SCHOOL V2-C1 §6 지시)
  commercialUseAllowed Boolean? @map("commercial_use_allowed")
  modificationAllowed  Boolean? @map("modification_allowed")

  legalReviewStatus LegalReviewStatus @default(UNKNOWN) @map("legal_review_status")
  termsCheckedAt    DateTime?         @map("terms_checked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  schoolStats       SchoolStat[]
  kindergartenStats KindergartenStat[]
  childcareStats    ChildcareStat[]

  @@map("education_sources")
}

// 학교 canonical entity. identity는 NEIS SD_SCHUL_CODE를 우선한다
// (SCHOOL V2-C §4-1) — 학교알리미 식별자와의 매핑은 아직 미확정이라
// 이 테이블에는 만들지 않는다(EducationIdentityMapping은 LATER,
// SCHOOL-V2-C1 §NOW/LATER 참고). schoolName은 절대 canonical key로
// 쓰지 않는다 — unique 제약을 걸지 않았다.
model School {
  id             Int     @id @default(autoincrement())
  neisSchoolCode String? @unique @map("neis_school_code") // NEIS SD_SCHUL_CODE, 미확보 school도 저장 가능하도록 nullable

  schoolName        String  @map("school_name") // NEIS SCHUL_NM — canonical key 아님, unique 없음
  schoolLevel       String? @map("school_level") // NEIS SCHUL_KND_SC_NM 원문 그대로("초등학교" 등)
  establishmentType String? @map("establishment_type") // NEIS FOND_SC_NM(공립/사립)
  genderType        String? @map("gender_type") // NEIS COEDU_SC_NM(남녀공학 구분)

  address     String? @map("address")
  roadAddress String? @map("road_address")
  sidoCode    String? @map("sido_code")
  sigunguCode String? @map("sigungu_code")
  dongName    String? @map("dong_name")

  latitude         Float?
  longitude        Float?
  coordinateSource String?        @map("coordinate_source")
  coordinateType   CoordinateType @default(UNKNOWN) @map("coordinate_type")

  phone    String?
  homepage String?

  isActive    Boolean              @default(true) @map("is_active") // 폐교 시 false로만 전환, row는 유지(§20)
  qualityFlag EducationDataQuality @default(COMPLETE) @map("quality_flag")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  stats SchoolStat[]

  @@index([sidoCode, sigunguCode])
  @@index([schoolLevel])
  @@map("schools")
}

// 학교 × 공시연도 temporal statistic(SCHOOL V2-C §6/§9). 세부 API
// field가 실제로 확인된 값만 typed column으로 두고(totalStudentCount 등
// 아님 — 아직 학교알리미 필드 레벨 스키마가 SCHOOL V2-B에서 미확정이라
// studentCount 등도 실제로는 ingestion 시점까지 항상 null일 수 있다),
// 학년별 세부는 gradeBreakdown Json으로만 열어둔다. 13-다 졸업생 진로
// 현황은 이 테이블에 넣지 않는다 — GraduateOutcomeSnapshot은 별도
// 테이블(LATER, 법적 게이트 미해소).
model SchoolStat {
  id       Int    @id @default(autoincrement())
  schoolId Int    @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  referenceYear  Int       @map("reference_year") // 통계 기준연도(필수 — idempotency key)
  disclosureYear Int?      @map("disclosure_year") // 실제 공시연도(기준연도와 다를 수 있어 분리)
  referenceDate  DateTime? @map("reference_date") // 더 정밀한 기준일이 확인되면 사용

  studentCount   Int?  @map("student_count")
  classCount     Int?  @map("class_count")
  teacherCount   Int?  @map("teacher_count")
  gradeBreakdown Json? @map("grade_breakdown") // 학년별 세부 — 필드 스키마 미확정 상태이므로 typed column화하지 않음

  sourceId        Int             @map("source_id")
  source          EducationSource @relation(fields: [sourceId], references: [id])
  sourceRecordId  String?         @map("source_record_id")
  fetchedAt       DateTime        @map("fetched_at")
  sourceUpdatedAt DateTime?       @map("source_updated_at")

  qualityFlag      EducationDataQuality @default(COMPLETE) @map("quality_flag")
  disclosureStatus DisclosureStatus     @default(UNKNOWN) @map("disclosure_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([schoolId, sourceId, referenceYear])
  @@index([schoolId])
  @@index([sourceId])
  @@map("school_stats")
}

// 유치원 canonical entity. 공식 기관코드 존재 자체가 SCHOOL V2-B에서
// 확인되지 않아 officialCode를 필수로 강제하지 않는다 — 코드가 없는
// 동안은 identityConfidence=LOW로 명시하고, 이름+주소만으로 DB unique
// canonical key를 강제하지 않는다(SCHOOL V2-C §4-2, 이번 STEP §9 지시).
model Kindergarten {
  id           Int     @id @default(autoincrement())
  officialCode String? @unique @map("official_code") // 확인되면 채움, 미확인 상태로도 row 생성 가능

  kindergartenName  String  @map("kindergarten_name") // canonical key 아님, unique 없음
  establishmentType String? @map("establishment_type") // 공립/사립 등

  address     String? @map("address")
  roadAddress String? @map("road_address")
  sidoCode    String? @map("sido_code")
  sigunguCode String? @map("sigungu_code")

  latitude         Float?
  longitude        Float?
  coordinateSource String?        @map("coordinate_source")
  coordinateType   CoordinateType @default(UNKNOWN) @map("coordinate_type")

  identityConfidence IdentityConfidence @default(LOW) @map("identity_confidence")

  isActive    Boolean              @default(true) @map("is_active")
  qualityFlag EducationDataQuality @default(COMPLETE) @map("quality_flag")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  stats KindergartenStat[]

  @@index([sidoCode, sigunguCode])
  @@map("kindergartens")
}

model KindergartenStat {
  id             Int          @id @default(autoincrement())
  kindergartenId Int          @map("kindergarten_id")
  kindergarten   Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)

  referenceYear Int       @map("reference_year") // idempotency key(§SCHOOL-V2-C1 §10)
  referenceDate DateTime? @map("reference_date")

  capacity     Int?  @map("capacity") // 정원
  enrollment   Int?  @map("enrollment") // 현원
  classCount   Int?  @map("class_count")
  staffCount   Int?  @map("staff_count")
  ageBreakdown Json? @map("age_breakdown") // 연령별 원아수 — 필드 스키마 미확정, Json으로만 보존

  hasShuttle     Boolean? @map("has_shuttle")
  hasAfterSchool Boolean? @map("has_after_school")

  sourceId        Int             @map("source_id")
  source          EducationSource @relation(fields: [sourceId], references: [id])
  sourceRecordId  String?         @map("source_record_id")
  fetchedAt       DateTime        @map("fetched_at")
  sourceUpdatedAt DateTime?       @map("source_updated_at")

  qualityFlag      EducationDataQuality @default(COMPLETE) @map("quality_flag")
  disclosureStatus DisclosureStatus     @default(UNKNOWN) @map("disclosure_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([kindergartenId, sourceId, referenceYear])
  @@index([kindergartenId])
  @@index([sourceId])
  @@map("kindergarten_stats")
}

// 어린이집 canonical entity. 시설코드가 SCHOOL V2-B에서 실제 확인된
// 공식 필드라 유치원과 달리 필수 unique key로 채택한다(SCHOOL V2-C §4-3).
model Childcare {
  id           Int    @id @default(autoincrement())
  facilityCode String @unique @map("facility_code") // 공식 시설코드, 확인된 identity — 필수

  childcareName String  @map("childcare_name")
  facilityType  String? @map("facility_type") // 국공립/민간/가정/직장 등

  address     String? @map("address")
  roadAddress String? @map("road_address")
  sidoCode    String? @map("sido_code")
  sigunguCode String? @map("sigungu_code")

  latitude         Float?
  longitude        Float?
  coordinateSource String?        @map("coordinate_source")
  coordinateType   CoordinateType @default(UNKNOWN) @map("coordinate_type")

  isActive    Boolean              @default(true) @map("is_active")
  qualityFlag EducationDataQuality @default(COMPLETE) @map("quality_flag")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  stats ChildcareStat[]

  @@index([sidoCode, sigunguCode])
  @@map("childcares")
}

// 어린이집은 정확한 갱신 주기가 SCHOOL V2-B에서 미확인("수시" 수준까지만
// 확인)이라 referenceYear 대신 referenceDate를 필수 temporal key로 쓴다
// (SCHOOL-V2-C1 §12 지시 그대로) — 연 단위로 확정되면 향후 별도
// migration으로 referenceYear를 추가할 수 있다.
model ChildcareStat {
  id          Int       @id @default(autoincrement())
  childcareId Int       @map("childcare_id")
  childcare   Childcare @relation(fields: [childcareId], references: [id], onDelete: Cascade)

  referenceDate DateTime @map("reference_date")

  capacity   Int?     @map("capacity")
  enrollment Int?     @map("enrollment")
  staffCount Int?     @map("staff_count")
  cctvCount  Int?     @map("cctv_count")
  hasShuttle Boolean? @map("has_shuttle")

  sourceId        Int             @map("source_id")
  source          EducationSource @relation(fields: [sourceId], references: [id])
  sourceRecordId  String?         @map("source_record_id")
  fetchedAt       DateTime        @map("fetched_at")
  sourceUpdatedAt DateTime?       @map("source_updated_at")

  qualityFlag      EducationDataQuality @default(COMPLETE) @map("quality_flag")
  disclosureStatus DisclosureStatus     @default(UNKNOWN) @map("disclosure_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([childcareId, sourceId, referenceDate])
  @@index([childcareId])
  @@index([sourceId])
  @@map("childcare_stats")
}

// ??????????????????????????????????????????????????????????????????????????
// AUTH/MY V1 - 사용자 계정 개인 데이터
// ??????????????????????????????????????????????????????????????????????????

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  lawdCd    String   @map("lawd_cd")
  dong      String
  name      String
  aptSeq    String?  @map("apt_seq")
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lawdCd, dong, name])
  @@index([userId, createdAt(desc)])
  @@map("favorites")
}

model RecentView {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  lawdCd   String   @map("lawd_cd")
  dong     String
  name     String
  aptSeq   String?  @map("apt_seq")
  address  String?
  viewedAt DateTime @default(now()) @map("viewed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lawdCd, dong, name])
  @@index([userId, viewedAt(desc)])
  @@map("recent_views")
}

model UserPreference {
  userId    String   @id @map("user_id")
  purposes  Json     @default("[]")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

enum PyeongProvenance {
  OFFICIAL_LABEL
  SUPPLY_AREA_DERIVED
  UNKNOWN
}

// DATA_COVERAGE_FIX_V1 — ApartmentMaster의 용적률/건폐율/주차대수가 건축물대장의 어느
// operation에서 왔는지 감사 가능하게 남긴다(APARTMENT_BASIC_DATA_COVERAGE_AUDIT_V1의
// WRONG_SOURCE_SELECTION 재발 방지). 필드별로 나누지 않고 레코드 단위 하나로 두는 이유:
// 이 값들은 항상 같은 API 응답 1건(총괄표제부 또는 표제부 fallback)에서 함께 나오므로
// 필드마다 다른 source를 가질 수 없다 — 불필요한 schema 확대를 피한다.
enum BasicSpecSource {
  BUILDINGHUB_GENERAL_TITLE // 총괄표제부(getBrRecapTitleInfo) — 단지 집계 확정값
  BUILDINGHUB_TITLE // 표제부(getBrTitleInfo) fallback — 지번 내 건물 정확히 1건일 때만
  UNKNOWN // 아직 backfill 안 됨/출처 미상(기존 값, 이번 STEP 이전 데이터)
}

enum UnitDataSource {
  BUILDING_REGISTRY
  PRESALE
  MANUAL_VERIFIED
  OTHER
}

model ApartmentUnitType {
  id          Int @id @default(autoincrement())
  apartmentId Int @map("apartment_id")

  // Identities
  canonicalExclusiveArea Decimal @map("canonical_exclusive_area")
  variantKey             String  @map("variant_key")

  // Data
  supplyArea                 Decimal?         @map("supply_area")
  representativePyeong       Int?             @map("representative_pyeong")
  representativePyeongSource PyeongProvenance @default(UNKNOWN) @map("representative_pyeong_source")
  officialType               String?          @map("official_type")
  householdCount             Int?             @map("household_count")

  // Provenance
  source         UnitDataSource @map("source")
  sourceMatchKey String?        @map("source_match_key")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  @@unique([apartmentId, canonicalExclusiveArea, variantKey])
  @@index([apartmentId, canonicalExclusiveArea])
  @@map("apartment_unit_types")
}

// ══════════════════════════════════════════════════════════════════════════
// TRADE_HISTORY_DATA_V1 — 아파트 매매 실거래 영구 이력. MOLIT RTMSDataSvcAptTradeDev
// raw 필드를 그대로 보존한다(display 가공값을 truth로 저장하지 않음, RAW FIRST 원칙).
// identity/area/그룹 판정은 이 STEP에서 새로 발명하지 않고 src/lib/regional-feed.ts가
// 이미 확립해 라이브 통계 화면이 쓰고 있는 identityKey()/areaKey()/groupKey() 함수를
// 그대로 호출해 계산한 값을 저장한다 — 나중에 통계 API를 DB-first로 전환할 때 정의가
// 어긋나지 않도록 하기 위함(별도 STEP: TRADE_HISTORY_READ_MIGRATION_V1).
//
// UNIQUE KEY 설계 근거(§7 DUPLICATE AUDIT 실측, 2026-08-29, 부산 서구 26140 3개월
// 250건 raw): 같은 (identity+area+dealType+dealAmount+dealDate+floor) 조합이 실제로
// 2건씩 존재하는 사례가 243개 그룹 중 7개(2.9%) 확인됨 — MOLIT 응답에 거래 일련번호가
// 없어 안전하게 구분할 다른 raw 필드가 없다. occurrenceIndex(같은 자연키 그룹 내 MOLIT
// 응답 원본 등장 순서, 0부터)를 최후 discriminator로 추가해 두 행을 병합하지 않는다 —
// 두 행은 이미 모든 관측 필드가 동일하므로, 재fetch마다 순서가 바뀌어도 저장값 자체는
// 항상 정확하다(어느 슬롯이 어느 행인지 뒤바뀔 뿐 내용은 똑같음).
//
// dealAmount/dealDate/floor가 UNIQUE 키에 포함되므로, "가격/일자 정정"은 새 행으로
// 나타난다(기존 행이 자동으로 갱신되지 않음) — 이는 실제 국토부 실거래가 정정 관행과
// 일치한다: 정정은 원 신고를 해제(취소)하고 새 신고를 등록하는 방식으로 이뤄지므로,
// dealCanceled/cancelDate/registryDate(자연키 밖의 필드)에 대한 upsert만으로 취소
// 반영이 정확히 동작한다. 진짜 "같은 행의 가격만 조용히 수정"되는 사례는 관측되지
// 않았다(KNOWN LIMITATION — 문서 참고).
model ApartmentTradeHistory {
  id Int @id @default(autoincrement())

  source String @default("MOLIT_APT_TRADE") @map("source")

  // MOLIT 조회 파라미터(raw) — 배치 추적/재실행용. dealYmd는 항상 dealYear/dealMonth와
  // 같은 달이지만(MOLIT는 계약월 단위로만 조회 가능), 어느 fetch로 들어왔는지 감사하기
  // 위해 그대로 보존한다.
  lawdCd  String @map("lawd_cd")
  dealYmd String @map("deal_ymd")

  // Identity — regional-feed.ts의 identityKey()/areaKey()/groupKey()를 그대로 호출한
  // 결과를 저장한다(별도 재구현 금지, 라이브 통계와 동일 정의 보장).
  aptSeq      String? @map("apt_seq")
  identityKey String  @map("identity_key") // aptSeq 있으면 "id:{aptSeq}", 없으면 "nd:{name}|{dong}"
  dealType    String  @default("sale") @map("deal_type") // FeedTrade.dealType과 동일 값('sale'만 V1 범위)
  groupKeyStr String  @map("group_key") // identityKey::areaKey::dealType

  // Raw MOLIT 필드 — 가공 없이 그대로.
  aptName String  @map("apt_name")
  dong    String  @map("dong")
  jibun   String? @map("jibun")

  // 전용면적(㎡), raw 그대로(반올림/평형 변환 금지 — Unit Master protection 원칙과 동일).
  exclusiveArea Decimal @map("exclusive_area")

  dealAmount Int @map("deal_amount") // 만원 단위, 정수(float 금지)

  dealYear  Int      @map("deal_year")
  dealMonth Int      @map("deal_month")
  dealDay   Int      @map("deal_day")
  // 위 3개 raw 필드로부터 무손실 재구성한 날짜(범위 쿼리/인덱스 전용) — display 가공값이
  // 아니라 동일한 원본 정수 3개를 합친 것뿐이므로 truth 원칙에 위배되지 않는다.
  dealDate  DateTime @map("deal_date") @db.Date

  floor     Int? @map("floor")
  buildYear Int? @map("build_year")

  dealCanceled Boolean @default(false) @map("deal_canceled")
  cancelDate   String? @map("cancel_date") // raw 해제사유발생일(YYYYMMDD), 파싱 없이 원본 그대로
  registryDate String? @map("registry_date") // raw 등기일자

  // §6/§7 IDENTITY — 같은 자연키 내 MOLIT 응답 원본 등장 순서(0부터). 위 모델 주석 참고.
  occurrenceIndex Int @default(0) @map("occurrence_index")

  rawUid String? @map("raw_uid") // fetchMolitData()가 만든 합성 id — 디버그 추적용, identity 아님

  sourceFetchedAt DateTime @default(now()) @map("source_fetched_at") // 이 row가 마지막으로 API 응답에서 확인된 시각(incremental sync용)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([groupKeyStr, dealAmount, dealDate, floor, occurrenceIndex], name: "trade_natural_key")
  @@index([aptSeq, exclusiveArea, dealDate])
  @@index([lawdCd, dealDate])
  @@index([identityKey, dealDate])
  @@index([dealDate])
  // PERFORMANCE_V1_1_A — 부산 전체(lawdCd IN(16)) + exclusiveArea range(84~85) +
  // dealDate range 조합을 커버하는 인덱스가 없어 area84 sido-wide 조회가
  // 기존 (lawdCd, dealDate) 인덱스만으로 67,638행을 걸러낸 뒤 44,736행을
  // filter로 버리고 있었다(EXPLAIN ANALYZE로 실측). lawdCd를 앞에 두는 이유는
  // 지금은 이 테이블이 사실상 전부 부산이라 선택도가 낮지만(§10), 진행 중인
  // 전국 확장 이후에는 다시 선택적으로 동작하며, 단일 구 조회(이미 빠름)도
  // 계속 이 인덱스의 prefix로 커버된다.
  @@index([lawdCd, exclusiveArea, dealDate])
  @@map("apartment_trade_histories")
}

// RENT_TRADE_HISTORY_V1 PHASE B — 전월세(RTMSDataSvcAptRent) 전용 테이블. sale의
// ApartmentTradeHistory와 별도 테이블인 이유는 PHASE A(docs/development/
// RENT_TRADE_HISTORY_V1_ARCHITECTURE.md §12)에 근거: 금액 필드가 2개(보증금+월세)이고
// 취소/해제 개념이 source에 아예 없어 sale 전용 컬럼(dealCanceled 등)을 억지로
// nullable화하지 않기 위함.
model ApartmentRentHistory {
  id Int @id @default(autoincrement())

  source String @default("MOLIT_APT_RENT") @map("source")

  lawdCd  String @map("lawd_cd")
  dealYmd String @map("deal_ymd")

  // Identity — trade-history-logic.ts의 identityKey()/groupKey()와 동일 정의를
  // rent-history-logic.ts에 별도 복제해 사용한다(§ trade-history-logic.ts 헤더 주석과
  // 동일한 도구 제약 — scripts/*.ts 확장자 없는 상호 import 불가).
  aptSeq      String? @map("apt_seq") // PHASE A §10: 실측 샘플 100% 존재하지만 sale과 동일하게 방어적으로 nullable 유지
  identityKey String  @map("identity_key") // aptSeq 있으면 "id:{aptSeq}", 없으면 "nd:{name}|{dong}"
  dealType    String  @map("deal_type") // 'jeonse' | 'wolse' — monthlyRent===0이면 jeonse, 아니면 wolse(ingestion 시점에 1회 결정, 재계산 금지)
  groupKeyStr String  @map("group_key") // identityKey::areaKey::dealType

  aptName String  @map("apt_name")
  dong    String  @map("dong")
  jibun   String? @map("jibun")

  // 전용면적(㎡), raw 그대로(반올림/평형 변환 금지 — Unit Master protection 원칙과 동일).
  exclusiveArea Decimal @map("exclusive_area")

  deposit     Int @map("deposit") // 만원 단위, 정수(float 금지). PHASE A §5: sale의 dealAmount와 동일 관례
  monthlyRent Int @map("monthly_rent") // 만원 단위, jeonse는 항상 0(§4)

  dealYear  Int      @map("deal_year")
  dealMonth Int      @map("deal_month")
  dealDay   Int      @map("deal_day")
  dealDate  DateTime @map("deal_date") @db.Date

  floor     Int? @map("floor")
  buildYear Int? @map("build_year")

  // PHASE A §8/§9 — 갱신계약(contractType='갱신') 전용 필드. 신규계약/수집 이전 데이터는
  // 항상 null이며, 강제로 false/0/'신규'를 채우지 않는다(원본에 없는 값 생성 금지).
  contractType    String?  @map("contract_type") // '신규' | '갱신' | null
  contractTerm    String?  @map("contract_term") // free-text 계약기간, 예: "26.01~27.01"
  preDeposit      Int?     @map("pre_deposit")
  preMonthlyRent  Int?     @map("pre_monthly_rent")
  useRenewalRight Boolean? @map("use_renewal_right") // PHASE A §12: null=미기재(UNKNOWN), true=사용 확인. source에 "미사용" 값이 없으므로 false는 절대 쓰지 않는다

  // PHASE A §7 — 의도적으로 dealCanceled/isCanceled/canceledAt 필드를 두지 않는다.
  // RTMSDataSvcAptRent 응답에는 취소/해제/등기 관련 필드가 전혀 존재하지 않음을
  // 2,543건 실측으로 확인했다(등기일자/rgstDate/해제여부/cdealType/해제사유발생일/cdealDay
  // 전부 부재). 있지도 않은 신뢰를 암시하는 컬럼(예: dealCanceled=false 고정값)을
  // 만들지 않는다 — 이 테이블에서 "취소 제외" 개념은 존재하지 않는다.

  // PHASE A §11 — 자연키(groupKey+deposit+monthlyRent+dealDate+floor)만으로는 153건의
  // 실제 충돌이 존재(MOLIT가 공개 데이터에 호실 번호를 노출하지 않아 동일 층/면적/가격/
  // 날짜의 서로 다른 호실이 실제로 존재). sale과 동일하게 occurrenceIndex로 병합 없이
  // 구분한다(같은 lawdCd+dealYmd 응답 원본 등장 순서, 0부터).
  occurrenceIndex Int @default(0) @map("occurrence_index")

  sourceFetchedAt DateTime @default(now()) @map("source_fetched_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([groupKeyStr, deposit, monthlyRent, dealDate, floor, occurrenceIndex], name: "rent_natural_key")
  @@index([aptSeq, exclusiveArea, dealDate])
  @@index([lawdCd, dealDate])
  @@index([identityKey, dealDate])
  @@index([dealDate])
  // PHASE A §14 — PERFORMANCE_V1.1-A의 교훈을 미리 반영: dashboard의 실제 조회 형태
  // (지역 + jeonse/wolse + 기간)를 커버하는 복합 인덱스를 sale처럼 사고 터진 뒤가 아니라
  // 처음부터 만든다.
  @@index([lawdCd, dealType, dealDate])
  @@map("apartment_rent_histories")
}

// DATA_FRESHNESS_AUTOMATION_V1_PHASE2 §24/§25 — 동기화 coverage 상태의 durable 저장소.
//
// 왜 새 테이블이 필요한가(Phase 2 감사 결과, docs/development/DATA_FRESHNESS_AUTOMATION_V1_PHASE2.md):
// Phase 1.5는 coverage를 git-tracked JSON 파일(data/rent-trade-history/coverage-manifest.json)에
// 기록하도록 설계했지만, Vercel에서는 그 파일이 **빌드 입력**이라 이를 읽는 함수마다 각자의
// 사본이 번들에 복사된다(빌드 산출물 .nft.json으로 실측 확인). 즉 cron 함수가 파일을 써도
// dashboard/admin 함수는 영원히 자기 사본만 본다. 게다가 rent-verified-range.ts는 module
// load 시점에 값을 상수로 고정한다. 파일 기반 coverage는 구조적으로 durable할 수 없다.
//
// 이 테이블은 그 유일한 신뢰 출처다. 셀 하나 = (dataset, lawdCd, dealYmd) 하나.
enum SyncDataset {
  SALE
  RENT
}

// rent-completeness-logic.ts / sale-pagination-logic.ts의 판정 결과와 1:1 대응한다.
// PARTIAL/INVALID는 "아직 검증되지 않음"이며, 절대 COMPLETE처럼 취급하지 않는다(§11/§12).
enum SyncCellStatus {
  COMPLETE
  EMPTY_VALID
  PARTIAL
  INVALID
}

model SyncCoverageCell {
  id Int @id @default(autoincrement())

  dataset SyncDataset @map("dataset")
  lawdCd  String      @map("lawd_cd")
  dealYmd String      @map("deal_ymd")

  status SyncCellStatus @map("status")

  // Provenance — 완전성 "주장"의 근거를 셀과 함께 보관한다. sourceTotalCount 없이
  // COMPLETE를 주장할 수 없다(§11 completeness 검증: source totalCount vs fetched).
  // 근거를 버리고 결론만 저장하면 ADMIN_OPS_V1.2에서 배운 실수를 반복하게 된다.
  sourceTotalCount Int? @map("source_total_count")
  fetchedCount     Int  @default(0) @map("fetched_count")
  blockedCount     Int  @default(0) @map("blocked_count")
  insertedCount    Int  @default(0) @map("inserted_count")
  updatedCount     Int  @default(0) @map("updated_count")

  // 어느 실행이 이 셀을 기록했는지 — 로그와 대조 가능하게 한다(§20 observability).
  runId String @map("run_id")

  // 이 셀이 실제로 검증된 시각(행 생성 시각이 아니라 검증 시각).
  verifiedAt DateTime @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([dataset, lawdCd, dealYmd], name: "sync_coverage_cell_key")
  // coverage 전진 판정은 "특정 월에 대해 16개 구가 전부 COMPLETE인가"를 묻는다.
  @@index([dataset, dealYmd, status])
  @@map("sync_coverage_cells")
}
